{
  "manifest_version": 3,
  "name": "The Desk Bridge",
  "version": "2.0.0",
  "description": "Sends the bars from your open TradingView chart to The Desk running on this computer (localhost:3000). It talks to nothing else.",
  "host_permissions": [
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/chart/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.tradingview.com/chart/*"
      ],
      "js": [
        "relay.js"
      ],
      "run_at": "document_idle"
    }
  ]
}