{
  "manifest_version": 3,
  "name": "NQ Desk Bridge",
  "version": "1.0.0",
  "description": "Sends the bars from your open TradingView chart to NQ Desk running on this computer (localhost:3000).",
  "host_permissions": ["http://localhost:3000/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    { "matches": ["https://*.tradingview.com/chart/*"], "js": ["page.js"], "world": "MAIN", "run_at": "document_idle" },
    { "matches": ["https://*.tradingview.com/chart/*"], "js": ["relay.js"], "run_at": "document_idle" }
  ]
}
